# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Yen Hub local data (passkeys, vault index cache, etc.)
/data

# Tauri build artifacts (huge — 700MB+ in target/)
/src-tauri/target
/src-tauri/gen

# Tauri-generated capabilities can stay tracked; only target is junk

# Local env
.env.local
.env*.local
